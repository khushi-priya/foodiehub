NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=foodiehub
DB_USER=root
DB_PASSWORD=replace-with-local-database-password
SESSION_SECRET=replace-with-a-long-random-secret

# SMTP for customer email verification (Gmail users must use a Google App Password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=your-email@gmail.com
